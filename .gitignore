# ============================================================
# Nutrition Agentic AI Application — .gitignore
# ============================================================

# ----- Python bytecode -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd
.Python

# ----- Eggs / packaging -----
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/
*.whl
pip-log.txt
pip-delete-this-directory.txt
MANIFEST

# ----- Virtual Environments -----
venv/
env/
ENV/
.venv/
.env_backup/
virtualenv/

# ----- Environment & Secrets (NEVER commit these) -----
.env
.env.local
.env.*.local
*.pem
*.key
ibm_credentials.env
wml_credentials.json
secrets.yaml
secrets.json

# ----- IDE & Editors -----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ----- Jupyter Notebooks -----
.ipynb_checkpoints/
*.ipynb_checkpoints
*.nbconvert

# ----- Testing & Coverage -----
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover
nosetests.xml
test-results/
.hypothesis/

# ----- Logs & Temp Files -----
*.log
*.tmp
*.bak
*.cache
logs/
tmp/
temp/

# ----- OS Generated -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Streamlit secrets (keep config.toml but not secrets) -----
.streamlit/secrets.toml
