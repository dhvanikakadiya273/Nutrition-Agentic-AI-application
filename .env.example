# ============================================================
# Nutrition Agentic AI Application — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git — it is excluded by .gitignore.
# ============================================================

# ----- IBM WatsonX AI Credentials -----
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_watsonx_api_key_here

# Get your Project ID from: https://dataplatform.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint — choose one:
#   Dallas   : https://us-south.ml.cloud.ibm.com
#   Frankfurt: https://eu-de.ml.cloud.ibm.com
#   Tokyo    : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ----- Model Configuration -----
# Recommended models:
#   ibm/granite-13b-chat-v2
#   meta-llama/llama-3-70b-instruct
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ----- Optional: Nutrition API Keys -----
# Uncomment and fill in if using external nutrition APIs
# USDA_API_KEY=your_usda_api_key_here
# EDAMAM_APP_ID=your_edamam_app_id_here
# EDAMAM_APP_KEY=your_edamam_app_key_here

# ----- App Settings -----
APP_PORT=8501
APP_DEBUG=false
